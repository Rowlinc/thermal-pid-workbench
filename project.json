// 温控项目配置（支持 // 行注释和 /* 块注释），程序可以直接读取。
// 只改冒号右侧的值；true=开启，false=关闭；null 的含义见各项说明。
// 初学先看 model（对象）、task（目标）、actuator（输出）、evaluation（合格条件）；LLM 和设备可先关闭。
{
  // 配置格式版本。保持 1，通常不需要修改。 默认值：1。
  "schema_version": 1,
  // 本次实验的名称，用来区分不同任务，可改成自己方便辨认的名字。 默认值："temperature_30_to_100"。
  "name": "temperature_30_to_100",
  // 运行模式：test=只计算参数并仿真；use=仿真合格后通过配置的设备接口接入。初学先用 test。 默认值："test"。
  "mode": "test",
  // 被控量定义：全流程使用这里指定的名称和单位，不自动换算。
  "process": {
    // 被控量类型：temperature=温度；pressure=压力；flow=流量；level=液位；speed=转速；custom=其他单回路变量。 默认值："temperature"。
    "kind": "temperature",
    // 被控量显示名称，例如压力、流量或液位。 默认值："温度"。
    "name": "温度",
    // 被控量单位，例如 ℃、MPa、m³/h。模型、数据、目标和误差必须使用同一单位。 默认值："℃"。
    "unit": "℃"
  },
  // 对象模型：描述“改变加热功率或阀位后，温度如何响应”，不是本次任务的目标。
  "model": {
    // 模型类型：fopdt=一阶惯性加滞后；integrating=积分加滞后；heating=摄氏两节点加热模型；custom=自定义模型。 默认值："fopdt"。
    "type": "fopdt",
    // 来源：parameters=已知 FOPDT K/τ/θ 或积分 K/θ；csv=历史阶跃 FOPDT 辨识；probe=离线模型阶跃辨识；manual=从用户初始 PID 仿真并可选 LLM，不套用辨识公式。 默认值："parameters"。
    "source": "parameters",
    // 过程增益，单位 °C/输出单位。例如输出用 %，K=1 表示输出增加 1 个百分点，稳态温度约增加 1°C；降温对象可为负，不能为 0。probe 时也须填对方向。 默认值：1.0。
    "K": 1.0,
    // 时间常数 τ，单位秒，必须大于 0：响应经过延迟后，再过 τ 秒，大约完成最终温度变化的 63.2%。参数来源为 parameters 时用于整定；CSV 时由数据覆盖。 默认值：120.0。
    "tau_s": 120.0,
    // 纯延迟 θ，单位秒，不能为负：改变输出后，等待多久才开始影响温度。Z-N 需要它大于 0；SIMC 可以为 0。 默认值：10.0。
    "theta_s": 10.0,
    // 模型工作点温度，单位 °C，与 operating_output 对应的稳定温度；不同于任务初始温度。默认工作点为输出 0 时 20°C。 默认值：20.0。
    "operating_temperature_c": 20.0,
    // 模型工作点输出，单位同 actuator.unit；FOPDT 稳态温度=工作点温度+K×(输出−工作点输出)。必须在输出范围内。 默认值：0.0。
    "operating_output": 0.0,
    // 仅 heating 使用：加热器每增加一个输出单位，对应的稳态加热器温升，单位 °C/输出单位，必须大于 0。 默认值：3.0。
    "heater_gain_c_per_output": 3.0,
    // 仅 heating 使用：加热器自身响应的时间常数，单位秒，必须大于 0。 默认值：10.0。
    "heater_tau_s": 10.0,
    // 仅 heating 使用：加热器与被控对象之间的传热系数，单位 1/秒，必须大于 0；越大传热越快。 默认值：0.5。
    "heat_transfer_per_s": 0.5,
    // 仅 heating 使用：被控对象向环境散热的系数，单位 1/秒，不能为负；越大散热越快。 默认值：0.05。
    "cooling_per_s": 0.05,
    // 仅 custom 使用：模型工厂的“模块:函数”名称，例如 examples.custom_model:create_model；普通内置模型留空。 默认值：""。
    "custom_factory": ""
  },
  // 历史数据设置。只在 model.source=csv 时读取；CSV 需要时间、温度、实际输出，包含单次阶跃前基线和阶跃后的基本稳定末段。
  "history": {
    // 历史 CSV 路径，相对于本配置文件所在目录，例如 data/step.csv；不用历史数据时留空。 默认值：""。
    "file": "",
    // CSV 时间列的单位：s=秒；ms=毫秒。必须与数据一致，避免把对象速度辨识错 1000 倍。 默认值："s"。
    "time_unit": "s",
    // CSV 列名映射。左边是程序固定名称，只改右边，使它与自己 CSV 的表头一致。
    "columns": {
      // CSV 中记录时间的列名，例如 timestamp 或 time_s。 默认值："timestamp"。
      "time": "timestamp",
      // CSV 中记录实际温度（°C）的列名，例如 input 或 temperature_c。 默认值："input"。
      "temperature": "input",
      // CSV 中记录实际加热功率/阀位的列名，例如 pwm 或 valve_percent；单位须与 actuator 一致。 默认值："pwm"。
      "output": "pwm"
    },
    // true=用 CSV 阶跃前的温度和输出作为模型工作点；false=使用上面手动填写的工作点。 默认值：true。
    "use_recorded_operating_point": true
  },
  // 辨识设置：控制离线阶跃实验及拟合质量。这里的 probe 不会向真实装置发阶跃命令。
  "identification": {
    // 离线阶跃记录总时长，单位秒，包含短基线；要足够长，使对象响应接近稳定。已知模型做原辨识对照时也使用它。 默认值：960.0。
    "probe_duration_s": 960.0,
    // 离线阶跃的输出变化幅度，单位同 actuator.unit；输出用 % 时 20 表示改变 20 个百分点。须能落在执行器范围内。 默认值：20.0。
    "probe_output_change": 20.0,
    // 允许的 FOPDT 拟合相对误差上限：RMSE/阶跃温度变化幅度。0.05=5%；超限拒绝继续，需检查数据或模型适用性。 默认值：0.05。
    "max_relative_rmse": 0.05
  },
  // 本次任务：告诉程序“从什么状态开始，要达到什么目标”。
  "task": {
    // 任务开始时被控对象温度，单位 °C。use 模式读取设备实际温度覆盖此值。 默认值：30.0。
    "initial_temperature_c": 30.0,
    // 希望达到的目标温度，单位 °C。例如从 30°C 升到 100°C，这里填 100；修改目标后也要检查评价和停止温度范围。 默认值：100.0。
    "target_temperature_c": 100.0,
    // 环境温度，单位 °C，仅 heating 的散热/加热模型使用；FOPDT 使用自己的工作点，不额外叠加此值。 默认值：20.0。
    "ambient_temperature_c": 20.0,
    // 加热器自身的初始温度，单位 °C，仅 heating 使用；与被控对象初温可以不同。 默认值：30.0。
    "initial_heater_temperature_c": 30.0,
    // 任务开始时的加热功率/阀位，单位同 actuator；也是 FOPDT 延迟前输入历史的假定值。use 模式从设备读回。 默认值：0.0。
    "initial_output": 0.0
  },
  // 执行器：实际输出的单位、允许范围和动作速度，例如加热功率百分比或阀门开度。
  "actuator": {
    // 输出单位名称，例如 %、kW、valve_steps；只写单位不会自动换算，K、初始输出、CSV 和设备必须使用相同量纲。 默认值："%"。
    "unit": "%",
    // 执行器允许的最小输出，单位同 unit。例如百分比输出通常为 0；必须小于 max。 默认值：0.0。
    "min": 0.0,
    // 执行器允许的最大输出，单位同 unit。例如百分比输出通常为 100；不是旧项目固定的 255 PWM。 默认值：100.0。
    "max": 100.0,
    // 每秒允许的最大输出变化量。例如输出为 % 时，10 表示每秒最多变 10 个百分点；null=不限制速率。 默认值：10.0。
    "max_rate_per_s": 10.0
  },
  // 控制器设置：PID 参数表示、计算周期、微分滤波以及程序级参数护栏。
  "controller": {
    // 导出/设备的 PID 形式：parallel=Kp/Ki/Kd 并联式；ideal=Kp/Ti/Td 理想式。内部始终使用并联式，不支持串联式。 默认值："parallel"。
    "form": "parallel",
    // 导出/设备参数的时间单位：s=秒；min=分钟，程序自动换算。initial_pid 和 limits 始终按秒制填写。 默认值："s"。
    "parameter_time_unit": "s",
    // 控制计算周期，单位秒。例如 1=每秒算一次 PID；应与真实控制器一致，仿真时长须为它的整数倍。 默认值：1.0。
    "sample_time_s": 1.0,
    // 微分作用位置：measurement=对实际温度变化取微分，减少设定值突变冲击；error=对目标减温度的误差取微分。 默认值："measurement"。
    "derivative_on": "measurement",
    // 微分一阶滤波时间，单位秒；越大滤波越强但更迟缓，0=不滤波。D=0 时该设置不影响微分输出。 默认值：0.5。
    "derivative_filter_s": 0.5,
    // 任务开始/换参数时的内部状态：zero=积分和微分状态复位；tracking=预置积分以匹配当前输出，方便平滑接管。设备须支持相同语义。 默认值："zero"。
    "initialization": "zero",
    // 护栏策略：auto=test 初始公式与最终参数检查有效数值和绝对范围，LLM 每轮再检查相对增幅；use 所有阶段检查相对增幅，最终检查相对设备起始参数的总增幅。relative=所有模式初始候选也检查相对增幅。任何超限或无效都拒绝整组，不裁剪；LLM 收到原因后在剩余轮次重新建议。参照为零的项只检查绝对范围。 默认值："auto"。
    "guardrail_policy": "auto",
    // 参考 PID，不是最终推荐结果。use 模式从设备读取并限制相对它的增幅；relative 策略也用它限制离线公式。auto+test 不用默认参考值裁剪公式参数；LLM 每轮相对当前仿真参数限制增幅。全部为秒制并联非负幅值，方向由 K 决定。
    "initial_pid": {
      // 起始比例增益 Kp，单位 输出单位/°C；误差越大，比例输出越大。 默认值：1.0。
      "p": 1.0,
      // 起始积分增益 Ki，单位 输出单位/(°C·秒)；累计误差以消除稳态温差，0 表示关闭积分。 默认值：0.01。
      "i": 0.01,
      // 起始微分增益 Kd，单位 输出单位·秒/°C；对温度变化提供阻尼，0 表示关闭微分。 默认值：0.0。
      "d": 0.0
    },
    // 对 Z-N、SIMC 和 LLM 生效的确定性参数护栏。它只限制程序参数，不代替现场过程保护。
    "limits": {
      // 比例 Kp 的护栏，单位与 initial_pid.p 一致；这不是执行器输出范围。
      "p": {
        // 比例 Kp 允许的最小非负值。 默认值：0.0。
        "min": 0.0,
        // 比例 Kp 允许的最大值；所有算法和 LLM 都要遵守。 默认值：5000.0。
        "max": 5000.0,
        // 比例 Kp 在相对增幅检查阶段的最大增长倍数，至少为 1；例如 3=最多增至参照值的 3 倍。auto+test 的初始公式不按默认参考值裁剪。参照为 0 时只执行绝对上下限。 默认值：3.0。
        "max_increase_ratio": 3.0
      },
      // 积分 Ki 的护栏，单位与 initial_pid.i 一致；这不是执行器输出范围。
      "i": {
        // 积分 Ki 允许的最小非负值。 默认值：0.0。
        "min": 0.0,
        // 积分 Ki 允许的最大值；所有算法和 LLM 都要遵守。 默认值：500.0。
        "max": 500.0,
        // 积分 Ki 在相对增幅检查阶段的最大增长倍数，至少为 1；例如 3=最多增至参照值的 3 倍。auto+test 的初始公式不按默认参考值裁剪。参照为 0 时只执行绝对上下限。 默认值：4.0。
        "max_increase_ratio": 4.0
      },
      // 微分 Kd 的护栏，单位与 initial_pid.d 一致；这不是执行器输出范围。
      "d": {
        // 微分 Kd 允许的最小非负值。 默认值：0.0。
        "min": 0.0,
        // 微分 Kd 允许的最大值；所有算法和 LLM 都要遵守。 默认值：500.0。
        "max": 500.0,
        // 微分 Kd 在相对增幅检查阶段的最大增长倍数，至少为 1；例如 3=最多增至参照值的 3 倍。auto+test 的初始公式不按默认参考值裁剪。参照为 0 时只执行绝对上下限。 默认值：4.0。
        "max_increase_ratio": 4.0
      }
    },
    // 启用相对增幅检查的阶段使用：0=只用每项自己的增长倍数；大于 1 时与每项倍数取较小值。auto+test 的初始公式与最终参数不使用增长倍数，但始终执行绝对范围检查。 默认值：0.0。
    "global_max_increase_ratio": 0.0
  },
  // 参与比较的传统整定算法及 SIMC 响应速度设置。
  "algorithms": {
    // 候选算法列表：ZN_PID=Z-N PID；ZN_PI=Z-N PI；SIMC_PI=SIMC PI。可删除候选，但至少保留一项，不能重复。 默认值：["ZN_PID", "ZN_PI", "SIMC_PI"]。
    "include": ["ZN_PID", "ZN_PI", "SIMC_PI"],
    // SIMC 闭环时间常数 λ，单位秒：null=自动用 max(θ,τ/3)。更大通常更缓和，更小通常更激进；必须为正，需看仿真结果。 默认值：null。
    "simc_lambda_s": null
  },
  // 评价要求：定义什么结果算合格。所有启用门槛必须同时满足，再按 IAE 和输出变化择优。
  "evaluation": {
    // 最大允许超调百分比，按目标与初始温度的温差计算。30→100°C 时 5%=允许超过目标 3.5°C；最高温度门槛还会单独检查。 默认值：5.0。
    "max_overshoot_pct": 5.0,
    // 全过程允许的最高温度，单位 °C。例如 102=任何时刻不能超过 102°C；null=关闭此评价门槛。 默认值：102.0。
    "max_temperature_c": 102.0,
    // 全过程允许的最低温度，单位 °C，降温任务尤其需要核对；null=关闭此评价门槛。 默认值：null。
    "min_temperature_c": null,
    // 仿真末段平均绝对温差上限，单位 °C。例如 0.3=末段平均需距目标不超过 0.3°C。 默认值：0.3。
    "max_tail_error_c": 0.3,
    // 判断稳定的温差带，单位 °C。例如目标 100、此项 1，则稳定区间为 99–101°C。 默认值：1.0。
    "settling_band_c": 1.0,
    // 允许的最晚调节时间，单位秒：进入温差带后须持续保持到结束；null=不限制时间上限，但仍要求稳定。 默认值：600.0。
    "max_settling_time_s": 600.0,
    // 进入温差带后至少还要观察多久，单位秒，避免最后一刻碰到目标就被判稳定。 默认值：20.0。
    "min_settled_observation_s": 20.0,
    // 末段评价使用最后多少比例的数据，范围大于 0 且不超过 1。例如 0.1=最后 10%。 默认值：0.1。
    "tail_fraction": 0.1,
    // 输出变化总量 TV 的最大值，单位同 actuator：把所有相邻输出变化的绝对值相加；null=不设此门槛，仍计算指标。 默认值：null。
    "max_output_variation": null,
    // 允许输出处于最小/最大限位的时间比例，范围 0–1。例如 0.2=最多 20%；null=不设此门槛。 默认值：null。
    "max_saturation_fraction": null
  },
  // 离线验证条件：时长、测量噪声、模型偏差和扰动。各组使用相同条件。
  "simulation": {
    // 每次完整闭环仿真时长，单位秒；须足够长观察稳定结果，并为 sample_time_s 的整数倍。 默认值：600.0。
    "duration_s": 600.0,
    // 随机种子，整数。同一配置和种子可复现同一组测量噪声，方便公平比较；无噪声时通常不用改。 默认值：0。
    "seed": 0,
    // 测温噪声的标准差，单位 °C。0=无噪声；例如 0.1 模拟有小幅测量噪声。噪声进入控制器，不直接改变真实温度。 默认值：0.0。
    "measurement_noise_std_c": 0.0,
    // 验证对象增益相对辨识模型的倍率。1=一致；0.8=实际对象增益低 20%，用于检查模型误差的影响。 默认值：1.0。
    "gain_scale": 1.0,
    // 持续扰动从仿真第几秒开始；null=不施加扰动。 默认值：null。
    "disturbance_time_s": null,
    // 扰动开始后持续施加的温度变化率，单位 °C/秒；负值持续降温，正值持续升温，0=无效果。这不是一次性温度跳变。 默认值：0.0。
    "disturbance_rate_c_per_s": 0.0,
    // 仿真最低停止温度，单位 °C；跌破后立即中止本次仿真并判不合格，不是现场保护。 默认值：-20.0。
    "temperature_stop_min_c": -20.0,
    // 仿真最高停止温度，单位 °C；超过后立即中止本次仿真并判不合格，应覆盖初温和目标。 默认值：150.0。
    "temperature_stop_max_c": 150.0
  },
  // LLM 调优轮数、曲线抽样和停止条件；LLM 关闭时不执行这些迭代。
  "tuning": {
    // 每条新路线最多仿真多少组通过参数护栏的 LLM 建议，正整数；被护栏拒绝的请求不占有效仿真轮数。旧连续核心仍以采样评价窗口计轮，拒绝重试复用当前窗口。 默认值：4。
    "rounds": 4,
    // true=各条离线调优路线并行运行，各自使用独立控制器、LLM客户端和旧核心配置；false=依次运行。仅并行规划，use最终仍只写入一组获选参数。 默认值：true。
    "parallel_routes": true,
    // 最大同时运行路线数，1到5，默认5；服务限流或自定义模型不能并行时可降低或关闭并行。每条路线内按反馈依次调优，轮数和请求预算不变。 默认值：5。
    "max_parallel_routes": 5,
    // 每轮首次建议被拒绝后最多重新请求几次，非负整数；默认 2=首次加两次重试。持续拒绝则结束该路线并保留最佳，继续其他路线。不会重新辨识或自动放宽限制。 默认值：2。
    "max_guardrail_retries_per_round": 2,
    // 每条路线最多调用多少次建议接口（含超限重试），正整数，默认 12；整个任务上限为参与路线数×本项。网络层重试另受 llm.max_attempts 限制；这不是 token 或费用上限。 默认值：12。
    "max_llm_requests_per_route": 12,
    // 发送给 LLM 的响应曲线抽样量，至少 5 点；这是抽样目标，实际数量可能略多，不会缩短完整仿真。 默认值：60。
    "samples_per_round": 60,
    // 连续多少轮满足评价要求及平均误差条件后停止；正整数。 默认值：2。
    "stable_rounds": 2,
    // 提前停止使用的完整任务平均绝对温差阈值，单位 °C，计算为 IAE/仿真时长；还必须满足全部评价门槛。 默认值：1.2。
    "average_error_threshold_c": 1.2,
    // 是否额外显示原辨识 Z-N 公式参考。该参考不经过 LLM，不等于旧版完整路线；关闭此项不会关闭旧版保底路线。 默认值：true。
    "compare_original": true,
    // 默认 true：纳入旧版完整连续调优路线，作为跨路线选优的保底候选。关闭则不具备相对旧版的保底比较。LLM关闭时只比较旧版初始化；不适用或运行失败会明确记录。 默认值：true。
    "include_legacy_route": true,
    // 启用LLM时，额外把修正Z-N初值交给保留的旧版连续调优核心，纳入混合路线比较；默认true。最终会明确标注混合路线，不能将其当作纯新版LLM策略的收益。关闭LLM、无Z-N候选或不适用时不运行。增加最多rounds次API建议请求，所有参数仍经护栏和完整任务复测。 默认值：true。
    "include_corrected_legacy_route": true,
    // 所有路线先满足硬约束，再按同一标准选优：accuracy=IAE优先；smooth=超调和输出平稳优先；speed=调节时间优先。同分保留旧版。 默认值："accuracy"。
    "selection_priority": "accuracy"
  },
  // 可选的大模型建议。默认关闭，传统 Z-N/SIMC 整定仍可运行。启用后会将模型和仿真摘要发到指定 API。
  "llm": {
    // 是否使用 LLM：false=纯传统算法比较；true=旧版、Z-N和SIMC各条适用路线分别调优，然后统一完整仿真和跨路线选优。调用次数随启用路线和轮次增加。 默认值：false。
    "enabled": false,
    // API 协议类型：openai=兼容 OpenAI 协议（也可连接 DeepSeek，并不表示必须用 OpenAI 模型）；anthropic=Anthropic 协议；auto=按地址判断。 默认值："openai"。
    "provider": "openai",
    // API 服务地址，例如 DeepSeek 为 https://api.deepseek.com/v1；不是网页聊天地址，需与 provider 匹配。 默认值："https://api.deepseek.com/v1"。
    "base_url": "https://api.deepseek.com/v1",
    // API 提供的模型名称，例如 deepseek-flash；须是自己的服务可调用的模型。 默认值："deepseek-flash"。
    "model": "deepseek-flash",
    // 本地密钥 JSON 文件路径，相对于本配置目录，读取其中 LLM_API_KEY；不要将真实密钥写到本文件或发布到 GitHub。 默认值："config.json"。
    "credentials_file": "config.json",
    // 保存 API key 的环境变量名称；程序优先读该变量，再读 credentials_file。这是变量名，不是密钥本身。 默认值："LLM_API_KEY"。
    "api_key_env": "LLM_API_KEY",
    // API 网络超时设置，单位秒；网络失败后可能重试或切换 HTTP 传输，不等于整次调优的总耗时上限。 默认值：60.0。
    "timeout_s": 60.0,
    // 一次建议请求的最大尝试次数，包括首次，例如 2=首次失败后最多再试一次。 默认值：2。
    "max_attempts": 2,
    // 单次回复的 token 上限，正整数；太小可能使 JSON 不完整，增大会增加潜在耗时和费用。 默认值：2048。
    "max_output_tokens": 2048,
    // true=向兼容 OpenAI 的 API 请求 JSON 格式；服务不支持时改 false。无论此项如何设置，程序都要解析并检查 PID。 默认值：true。
    "json_output": true,
    // 仅官方 DeepSeek 地址使用：disabled=关闭思考模式；enabled=开启；provider_default=不发送此设置，使用服务默认。 默认值："disabled"。
    "deepseek_thinking": "disabled"
  },
  // 设备接入设置，仅 use 模式创建接口。test 模式不连接设备；simulated 只操作内存中的模拟对象。
  "device": {
    // 接口类型：disabled=禁用；simulated=本机模拟；tcp=TCP JSONL 网关；serial=串口 JSONL 网关；custom=自己的适配器。 默认值："disabled"。
    "adapter": "disabled",
    // 允许设备参数写入的显式开关。use 必须为 true 且接口已配置；test 不因设 true 就连接设备。 默认值：false。
    "write_enabled": false,
    // 控制回路的唯一标识，例如 temperature-loop-1，必须与网关读回的对象一致，防止写错回路。 默认值："temperature-loop-1"。
    "object_id": "temperature-loop-1",
    // 仅 tcp 使用：网关 IP 或主机名，例如本机联调用 127.0.0.1；不使用 TCP 时留空。 默认值：""。
    "host": "",
    // 仅 tcp 使用：网关端口号，1–65535，必须与网关监听端口一致。 默认值：9100。
    "port": 9100,
    // 仅 serial 使用：串口名称，例如 Windows 的 COM3 或 Linux 的 /dev/ttyUSB0；其余接口留空。 默认值：""。
    "serial_port": "",
    // 仅 serial 使用：串口波特率，须与网关设置一致，例如 115200。 默认值：115200。
    "baud": 115200,
    // 仅 custom 使用：设备适配器工厂的“模块:函数”名称，须实现读状态、条件写参数、关闭接口。 默认值：""。
    "custom_factory": "",
    // 设备接口通信超时，单位秒；超时会报错，不会把未确认的写入当作成功。 默认值：5.0。
    "timeout_s": 5.0,
    // 接受设备状态的最大数据年龄，单位秒；过旧数据拒绝使用，设备需提供当前时间戳。 默认值：10.0。
    "max_sample_age_s": 10.0,
    // 写入并读回确认后，继续观察设备的时长，单位秒；0=只做读回确认，不继续监测；不是永久监控服务。 默认值：30.0。
    "monitor_duration_s": 30.0,
    // 设备监测间隔，单位秒，必须大于 0；模拟适配器按该设置计数并加速运行。 默认值：1.0。
    "monitor_interval_s": 1.0,
    // 设备监测允许的最低温度，单位 °C；越界报错，并按恢复配置尝试恢复参数。 默认值：-20.0。
    "monitor_min_temperature_c": -20.0,
    // 设备监测允许的最高温度，单位 °C；越界报错，不代替独立现场保护。 默认值：120.0。
    "monitor_max_temperature_c": 120.0,
    // true=本程序已确认写入且配置版本仍属于本程序时，异常后尝试恢复旧 PID/目标；false=不尝试自动恢复。断线或被别人改动时不保证能恢复。 默认值：true。
    "restore_on_fault": true,
    // 离线计算期间，设备温度相对最初读数允许变化多少 °C；写前超过此值则拒绝写入，需重新计算。 默认值：2.0。
    "max_planning_temperature_change_c": 2.0,
    // 离线计算期间，设备输出相对最初读数允许变化多少，单位同 actuator；写前超过此值则拒绝写入。 默认值：5.0。
    "max_planning_output_change": 5.0
  },
  // 结果保存设置。
  "output": {
    // 结果根目录，相对于本配置文件目录；每次运行自动建立独立时间戳子目录，在其中保存 report.html、pid.json、summary.json 等，不覆盖历史结果。 默认值："results/project"。
    "directory": "results/project",
    // true=另存指标和响应 CSV 供绘图分析；false=不生成这些 CSV，仍保存报告和 JSON。 默认值：true。
    "save_csv": true
  }
}
