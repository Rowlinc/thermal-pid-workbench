// 离线PID测试配置：未列项使用程序公共默认值，不读取根project.json的私有设置。
// 修改冒号右侧的值；test不连接设备；密钥保存在项目根config.json。
{
  // 运行模式：test=只计算参数并仿真；use=仿真合格后通过配置的设备接口接入。初学先用 test。
  "mode": "test",
  // 可选的大模型建议。默认关闭，传统 Z-N/SIMC 整定仍可运行。启用后会将模型和仿真摘要发到指定 API。
  "llm": {
    // 是否使用 LLM：false=纯传统算法比较；true=旧版、Z-N和SIMC各条适用路线分别调优，然后统一完整仿真和跨路线选优。调用次数随启用路线和轮次增加。
    "enabled": true,
    // 本地密钥 JSON 文件路径，相对于本配置目录，读取其中 LLM_API_KEY；不要将真实密钥写到本文件或发布到 GitHub。
    "credentials_file": "../../config.json",
    // 仅官方 DeepSeek 地址使用：disabled=关闭思考模式；enabled=开启；provider_default=不发送此设置，使用服务默认。
    "deepseek_thinking": "disabled",
    // 单次回复的 token 上限，正整数；太小可能使 JSON 不完整，增大会增加潜在耗时和费用。
    "max_output_tokens": 4096,
    // 一次建议请求的最大尝试次数，包括首次，例如 2=首次失败后最多再试一次。
    "max_attempts": 1,
    // API 网络超时设置，单位秒；网络失败后可能重试或切换 HTTP 传输，不等于整次调优的总耗时上限。
    "timeout_s": 60
  },
  // LLM 调优轮数、曲线抽样和停止条件；LLM 关闭时不执行这些迭代。
  "tuning": {
    // 默认 true：纳入旧版完整连续调优路线，作为跨路线选优的保底候选。关闭则不具备相对旧版的保底比较。LLM关闭时只比较旧版初始化；不适用或运行失败会明确记录。
    "include_legacy_route": true,
    // 每条新路线最多仿真多少组通过参数护栏的 LLM 建议，正整数；被护栏拒绝的请求不占有效仿真轮数。旧连续核心仍以采样评价窗口计轮，拒绝重试复用当前窗口。
    "rounds": 4,
    // 发送给 LLM 的响应曲线抽样量，至少 5 点；这是抽样目标，实际数量可能略多，不会缩短完整仿真。
    "samples_per_round": 60,
    // 所有路线先满足硬约束，再按同一标准选优：accuracy=IAE优先；smooth=超调和输出平稳优先；speed=调节时间优先。同分保留旧版。
    "selection_priority": "smooth",
    // 提前停止使用的完整任务平均绝对温差阈值，单位 bar，计算为 IAE/仿真时长；还必须满足全部评价门槛。
    "average_error_threshold": 0.06,
    // 启用LLM时，额外把修正Z-N初值交给保留的旧版连续调优核心，纳入混合路线比较；默认true。最终会明确标注混合路线，不能将其当作纯新版LLM策略的收益。关闭LLM、无Z-N候选或不适用时不运行。增加最多rounds次API建议请求，所有参数仍经护栏和完整任务复测。
    "include_corrected_legacy_route": true
  },
  // 结果保存设置。
  "output": {
    // 结果根目录，相对于本配置文件目录；每次运行自动建立独立时间戳子目录，在其中保存 report.html、pid.json、summary.json 等，不覆盖历史结果。
    "directory": "../../results/route_benchmarks/05_pressure"
  },
  // 本次实验的名称，用来区分不同任务，可改成自己方便辨认的名字。
  "name": "压力2至5bar_平稳优先",
  // 被控量定义：全流程使用这里指定的名称和单位，不自动换算。
  "process": {
    // 被控量类型：temperature=压力；pressure=压力；flow=流量；level=液位；speed=转速；custom=其他单回路变量。
    "kind": "pressure",
    // 被控量显示名称，例如压力、流量或液位。
    "name": "压力",
    // 被控量单位，例如 bar、MPa、m³/h。模型、数据、目标和误差必须使用同一单位。
    "unit": "bar"
  },
  // 对象模型：描述“改变执行器输出或阀位后，压力如何响应”，不是本次任务的目标。
  "model": {
    // 过程增益，单位 bar/输出单位。例如输出用 %，K=1 表示输出增加 1 个百分点，稳态压力约增加 1bar；降温对象可为负，不能为 0。probe 时也须填对方向。
    "K": 0.1,
    // 时间常数 τ，单位秒，必须大于 0：响应经过延迟后，再过 τ 秒，大约完成最终压力变化的 63.2%。参数来源为 parameters 时用于整定；CSV 时由数据覆盖。
    "tau_s": 12,
    // 纯延迟 θ，单位秒，不能为负：改变输出后，等待多久才开始影响压力。Z-N 需要它大于 0；SIMC 可以为 0。
    "theta_s": 2,
    // 模型工作点压力，单位 bar，与 operating_output 对应的稳定压力；不同于任务初始压力。默认工作点为输出 0 时 20bar。
    "operating_value": 2
  },
  // 本次任务：告诉程序“从什么状态开始，要达到什么目标”。
  "task": {
    // 任务开始时被控对象压力，单位 bar。use 模式读取设备实际压力覆盖此值。
    "initial_value": 2,
    // 希望达到的目标压力，单位 bar。例如从 30bar 升到 100bar，这里填 100；修改目标后也要检查评价和停止压力范围。
    "target_value": 5
  },
  // 控制器设置：PID 参数表示、计算周期、微分滤波以及程序级参数护栏。
  "controller": {
    // 控制计算周期，单位秒。例如 1=每秒算一次 PID；应与真实控制器一致，仿真时长须为它的整数倍。
    "sample_time_s": 0.2,
    // 参考 PID，不是最终推荐结果。use 模式从设备读取并限制相对它的增幅；relative 策略也用它限制离线公式。auto+test 不用默认参考值裁剪公式参数；LLM 每轮相对当前仿真参数限制增幅。全部为秒制并联非负幅值，方向由 K 决定。
    "initial_pid": {
      // 起始比例增益 Kp，单位 输出单位/bar；误差越大，比例输出越大。
      "p": 10,
      // 起始积分增益 Ki，单位 输出单位/(bar·秒)；累计误差以消除稳态温差，0 表示关闭积分。
      "i": 0.1,
      // 起始微分增益 Kd，单位 输出单位·秒/bar；对压力变化提供阻尼，0 表示关闭微分。
      "d": 0
    },
    // 微分一阶滤波时间，单位秒；越大滤波越强但更迟缓，0=不滤波。D=0 时该设置不影响微分输出。
    "derivative_filter_s": 0.4
  },
  // 辨识设置：控制离线阶跃实验及拟合质量。这里的 probe 不会向真实装置发阶跃命令。
  "identification": {
    // 离线阶跃记录总时长，单位秒，包含短基线；要足够长，使对象响应接近稳定。已知模型做原辨识对照时也使用它。
    "probe_duration_s": 120
  },
  // 评价要求：定义什么结果算合格。所有启用门槛必须同时满足，再按 IAE 和输出变化择优。
  "evaluation": {
    // 全过程允许的最高压力，单位 bar。例如 102=任何时刻不能超过 102bar；null=关闭此评价门槛。
    "max_value": 5.15,
    // 最大允许超调百分比，按目标与初始压力的温差计算。30→100bar 时 5%=允许超过目标 3.5bar；最高压力门槛还会单独检查。
    "max_overshoot_pct": 5,
    // 仿真末段平均绝对温差上限，单位 bar。例如 0.3=末段平均需距目标不超过 0.3bar。
    "max_tail_error": 0.03,
    // 判断稳定的温差带，单位 bar。例如目标 100、此项 1，则稳定区间为 99–101bar。
    "settling_band": 0.05,
    // 允许的最晚调节时间，单位秒：进入温差带后须持续保持到结束；null=不限制时间上限，但仍要求稳定。
    "max_settling_time_s": 100,
    // 进入温差带后至少还要观察多久，单位秒，避免最后一刻碰到目标就被判稳定。
    "min_settled_observation_s": 10
  },
  // 离线验证条件：时长、测量噪声、模型偏差和扰动。各组使用相同条件。
  "simulation": {
    // 每次完整闭环仿真时长，单位秒；须足够长观察稳定结果，并为 sample_time_s 的整数倍。
    "duration_s": 120,
    // 仿真最低停止压力，单位 bar；跌破后立即中止本次仿真并判不合格，不是现场保护。
    "stop_min": 0,
    // 仿真最高停止压力，单位 bar；超过后立即中止本次仿真并判不合格，应覆盖初温和目标。
    "stop_max": 8
  }
}
